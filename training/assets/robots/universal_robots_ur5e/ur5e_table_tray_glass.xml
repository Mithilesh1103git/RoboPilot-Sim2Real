<mujoco model="ur5e_workspace_scene">
  <compiler angle="radian" meshdir="assets"/>

  <!-- Include the raw UR5e robot model from your directory -->
  <include file="ur5e.xml"/>

  <!-- Global Environment Configurations -->
  <statistic center="0 0 0.5" extent="1.5"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
  </visual>

  <!-- Workspace Layout -->
  <worldbody>
    <!-- Floor Grid plane -->
    <geom name="floor" type="plane" size="0 0 0.05" rgba="0.8 0.8 0.8 1"/>

    <!-- Stable Light Source -->
    <light pos="0 0 3" dir="0 0 -1" directional="false"/>

    <!-- 1. THE TABLE -->
    <!-- Positioned along the negative X axis where the UR5e faces naturally -->
    <body name="table" pos="-0.5 0 0">
      <geom name="table_top" type="box" size="0.3 0.5 0.4" rgba="0.4 0.25 0.15 1"/>
    </body>

    <!-- 2. THE TRAY -->
    <!-- Equipped with an explicit freejoint to support 3D position vectors in Python -->
    <body name="tray" pos="-0.4 0 0.405">
      <freejoint name="tray_joint"/>
      <!-- Tray Floor -->
      <geom name="tray_bottom" type="box" size="0.15 0.25 0.005" rgba="0.7 0.7 0.7 1" mass="0.3"/>
      <!-- Tray Outer Rims for physical containment -->
      <geom name="tray_rim_n" type="box" pos="0.15 0 0.015" size="0.005 0.25 0.015" rgba="0.6 0.6 0.6 1"/>
      <geom name="tray_rim_s" type="box" pos="-0.15 0 0.015" size="0.005 0.25 0.015" rgba="0.6 0.6 0.6 1"/>
      <geom name="tray_rim_e" type="box" pos="0 0.25 0.015" size="0.15 0.005 0.015" rgba="0.6 0.6 0.6 1"/>
      <geom name="tray_rim_w" type="box" pos="0 -0.25 0.015" size="0.15 0.005 0.015" rgba="0.6 0.6 0.6 1"/>
    </body>

    <!-- 3. THE GLASS -->
    <!-- Equipped with a freejoint to allow independent translation and tipping dynamics -->
    <body name="glass" pos="-0.4 0 0.47">
      <freejoint name="glass_joint"/>
      <geom name="glass_cylinder" type="cylinder" size="0.03 0.06" rgba="0.7 0.9 1.0 0.5" mass="0.1" condim="4"/>
    </body>
  </worldbody>
</mujoco>
