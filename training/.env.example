APP_NAME=RoboPilot-Sim2Real
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_TIMEOUT_SECONDS=45
NEBIUS_TEMPERATURE=0.1
TAVILY_ENABLED=false
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=15
TAVILY_MAX_RESULTS=5
PLANNER_CONTEXT_CACHE_TTL_SECONDS=86400
ROBOPILOT_ASSETS_DIR=assets/robots
ROBOPILOT_DATA_DIR=data/adapter
