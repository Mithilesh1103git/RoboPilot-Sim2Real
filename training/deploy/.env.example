# S3-compatible object storage (Nebius Object Storage or another S3 endpoint)
OBJECT_STORAGE_BUCKET=your-bucket-name
S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
AWS_REGION=eu-north1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Prefix holding unified-buffer transition NPZ objects
# Empty disables background buffer watcher. Training runs are submitted via POST /runs.
BUFFER_WATCH_PREFIX=unified-buffer/
BUFFER_POLL_SECONDS=60
TRAINING_PORT=8080
