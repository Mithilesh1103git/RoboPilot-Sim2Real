FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libgl1 libglib2.0-0 libglfw3 && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY training/requirements-training.txt /workspace/training/requirements-training.txt
RUN python -m pip install --upgrade pip && python -m pip install -r /workspace/training/requirements-training.txt
COPY training /workspace/training
EXPOSE 8010
CMD ["python", "-m", "uvicorn", "training.main:app", "--host", "0.0.0.0", "--port", "8010"]
